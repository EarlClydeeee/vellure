# Supabase Configuration
# Project URL format: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Admin credentials (simulated auth for /admin/login)
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=admin1234
# Legacy alias still supported: ADMIN_USERNAME=admin@gmail.com

# Optional — seed script / elevated writes
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Optional — test customer (also created by 005_seed_test_users.sql)
TEST_USER_EMAIL=test@gmail.com
TEST_USER_PASSWORD=test1234
